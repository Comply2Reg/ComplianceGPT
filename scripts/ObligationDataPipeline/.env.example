# ==================================================
# Obligation Data Pipeline — Environment Configuration
# ==================================================

# --------------------------------------------------
# Database: document metadata (regulation_documents table)
# Supported: postgresql, mysql
# --------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=c2rdb
DB_USER=app_user
DB_PASSWORD=changeme
# Optional: connection string override (overrides individual vars if set)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname

# --------------------------------------------------
# S3: PDF files (used when file_path is not a full s3:// URI)
# --------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=regulens-uploaded-docs
# Optional: use IAM role / default profile (leave keys empty)
# AWS_PROFILE=default

# --------------------------------------------------
# Ingestion Pipeline
# --------------------------------------------------
# Output base directory; files organized as {OUTPUT_BASE}/{regulator}/{filename}.pdf
OUTPUT_BASE=./data/ingested
# Table and columns (regulation_documents schema)
DOCUMENTS_TABLE=regulation_documents
REGULATOR_COLUMN=regulator
# Column containing S3 path: full URI (s3://bucket/key) or key only
S3_KEY_COLUMN=file_path
# Act-only filter: WHERE UPPER(document_type) LIKE 'ACT%' OR UPPER(document_subtype) LIKE 'ACT%'
# Set to false to process ALL document types (circulars, guidelines, etc.)
ACT_ONLY=false
DOCUMENT_TYPE_COLUMN=document_type
DOCUMENT_SUBTYPE_COLUMN=document_subtype
# Download all regulators (true); when false, only those listed in REGULATORS
ALL_REGULATORS=true
# Comma-separated regulator codes when ALL_REGULATORS=false (e.g. SEBI,RBI,IRDA,IRDAI,MAS)
# REGULATORS=SEBI,RBI,IRDA
# Optional: map DB values to standard codes (e.g. IRDAI:IRDA)
# REGULATOR_ALIASES=IRDAI:IRDA

# --------------------------------------------------
# Structural Parsing & Chunking
# --------------------------------------------------
CHUNKS_OUTPUT_DIR=./data/chunks
# Path to ingestion manifest (default: {OUTPUT_BASE}/manifest.json)
# INGEST_MANIFEST_PATH=./data/ingested/manifest.json
CHUNK_STRATEGY=hybrid
MAX_CHUNK_CHARS=6000
MIN_CHUNK_CHARS=200
OVERLAP_CHARS=150
PDF_SKIP_PAGES=0
CHUNKING_WRITE_MANIFEST=true
CHUNKING_SKIP_EXISTING=false

# Ontology-driven pipeline
ONTOLOGY_CHUNKING=true
GRAPH_OUTPUT_DIR=./data/graph
# TRACEABILITY_INDEX_PATH=./data/chunks/traceability_index.json

# --------------------------------------------------
# LLM-assisted structural parsing (optional)
# When true, use an LLM to parse document structure
# (sections, articles, paragraphs, schedules, etc.) before building the graph
# and ontology-aware chunks. When false, uses regex-based parsing only.
# --------------------------------------------------
USE_LLM_STRUCTURE_PARSER=false
# LLM provider/model for structural parsing
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=4000
# Optional: dedicated API key for structural parsing LLM
# (falls back to OPENAI_API_KEY when unset and provider is OpenAI-compatible)
# LLM_API_KEY=

# --------------------------------------------------
# OpenAI: Obligation Extraction
# --------------------------------------------------
USE_OPENAI=true
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
MAX_CONCURRENCY=8
MAX_RETRIES=4
MAX_INPUT_TOKENS=4096
MAX_OUTPUT_TOKENS=1024

# --------------------------------------------------
# Pipeline Versioning & Metadata
# --------------------------------------------------
PIPELINE_VERSION=obl-pipeline-v2
PROMPT_VERSION=v2.0
PROCESSING_NODE=local-dev

# --------------------------------------------------
# Dataset Balancing (target class ratios)
# --------------------------------------------------
TARGET_OBLIGATION_RATIO=0.50
TARGET_NON_OBLIGATION_RATIO=0.20
TARGET_NEUTRAL_RATIO=0.30

# --------------------------------------------------
# Confidence Score Weights (composite scoring)
# --------------------------------------------------
CONFIDENCE_W_CLASSIFICATION=0.25
CONFIDENCE_W_MODALITY=0.15
CONFIDENCE_W_COMPLETENESS=0.20
CONFIDENCE_W_REASONING=0.15
CONFIDENCE_W_GROUNDING=0.25

# --------------------------------------------------
# Embeddings (run_ingest_vector.py)
# --------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# For OpenAI: EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small

# --------------------------------------------------
# Vector DB (Chroma)
# --------------------------------------------------
ENABLE_VECTOR_INGEST=true
VECTOR_DB_TYPE=chroma
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=obligation_chunks

# --------------------------------------------------
# Graph DB (Neo4j)
# --------------------------------------------------
ENABLE_GRAPH_INGEST=true
GRAPH_DB_TYPE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_LEVEL=INFO
