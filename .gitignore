# Secrets
.env
.env.*
!.env.example

# Local/source data
data/raw/

# Company reference parser (local only - do not publish)
reference-parser/



# Python environments
.venv/
.venv-rl/
venv/
env/

# Python cache
__pycache__/
*.pyc

# UK triage labels and datasets (scripts/triage/): model labels and anything
# containing AMBER (internal-use) text never enter git. GREEN datasets and
# gold sheets are small and OGL-licensed and may be committed deliberately.
data/uk/labels/cache/
data/uk/labels/*.jsonl
data/uk/labels/*.json
data/uk/datasets/internal/
data/uk/obligation/

# fine-tuned adapters and derived MLX data files
models/
data/uk/datasets/*/mlx/
data/uk/datasets/*/mlx_*/
data/uk/datasets/*/eval_*

# macOS directory metadata
.DS_Store

# process ids from background runs
logs/**/*.pid
logs/**/*.pids

# RegNano tasks/calibration/GRPO data: regenerate with scripts/regnano/mine.py;
# contains regulation text, so committing it is a deliberate decision
data/regnano/
logs/regnano/

# Agent playground (scripts/agent/): the index is rebuilt from the GREEN corpus;
# rollouts are large and regenerated per iteration.
data/agent/*.sqlite
data/agent/rollouts/
